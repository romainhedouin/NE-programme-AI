# Clé API Mistral : https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Chat (réponses rédigées)
MISTRAL_MODEL=mistral-small-latest

# Embeddings (recherche sémantique / RAG)
MISTRAL_EMBED_MODEL=mistral-embed

# Limites de consommation (optionnel, valeurs par défaut)
# LIMIT_CHAT_PER_MINUTE=5
# LIMIT_CHAT_PER_DAY=50
# LIMIT_SEARCH_PER_MINUTE=30
# LIMIT_CHAT_GLOBAL_PER_DAY=1000
# CHAT_MAX_TOKENS=1200
